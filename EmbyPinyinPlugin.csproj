<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies> <!-- 确保依赖项被复制到输出目录 -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>EmbyPinyinPlugin</AssemblyName>
    <RootNamespace>EmbyPinyinPlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 核心 Emby 依赖 -->
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.80" />
    <!-- 使用 TinyPinyin -->
    <PackageReference Include="TinyPinyin" Version="1.1.0" />
    <!-- 添加对 Microsoft.Extensions.Logging.Abstractions 的引用 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!-- 添加 ILRepack -->
    <PackageReference Include="ILRepack" Version="2.0.42">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ILRepack 合并依赖 -->
  <Target Name="ILRepack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="$(ILRepack) /out:&quot;$(TargetDir)$(TargetFileName)&quot; &quot;$(TargetPath)&quot; $(TargetDir)*.dll /lib:&quot;$(TargetDir)&quot; /primary" />
  </Target>

</Project>
