<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework> <!-- 保持 net8.0 -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>EmbyPinyinPlugin</AssemblyName>
    <RootNamespace>EmbyPinyinPlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 核心 Emby 依赖 -->
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.80" />
    <!-- 使用 TinyPinyin -->
    <PackageReference Include="TinyPinyin" Version="1.1.0" />
    <!-- 添加对 Microsoft.Extensions.Logging.Abstractions 的引用 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!-- 添加 ILRepack -->
    <PackageReference Include="ILRepack" Version="2.0.44"> <!-- 使用与 StrmAssistant 相同的版本 -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ILRepack 合并依赖 (模仿 StrmAssistant 的 PostBuild 事件) -->
  <Target Name="ILRepack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="$(ILRepack) /out:&quot;$(OutputPath)$(TargetFileName)&quot; &quot;$(TargetPath)&quot; $(TargetDir)TinyPinyin.dll /lib:&quot;$(TargetDir)&quot;" />
  </Target>

</Project>
