<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>EmbyPinyinPlugin</AssemblyName>
    <RootNamespace>EmbyPinyinPlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 核心 Emby 依赖 -->
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.80" />
    <!-- 使用 TinyPinyin -->
    <PackageReference Include="TinyPinyin" Version="1.1.0" />
    <!-- 添加对 Microsoft.Extensions.Logging.Abstractions 的引用 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!-- 使用 ILRepack.Lib.MSBuild.Task 替代 ILRepack -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.18.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- ILRepack 合并依赖 (使用 ILRepack.Lib.MSBuild.Task) -->
  <Target Name="ILRepack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <InputAssemblies Include="$(OutputPath)$(AssemblyName).dll" />
      <InputAssemblies Include="$(OutputPath)*.dll" Exclude="$(OutputPath)$(AssemblyName).dll" />
    </ItemGroup>
    <ILRepack
      OutputType="$(OutputType)"
      MainAssembly="$(OutputPath)$(AssemblyName).dll"
      OutputAssembly="$(OutputPath)$(AssemblyName).dll"
      InputAssemblies="@(InputAssemblies)"
      LibraryPath="$(OutputPath)"
      InternalizeExclude="@(AssemblyAttribute)"
      />
  </Target>

</Project>
