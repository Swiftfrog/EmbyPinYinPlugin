<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework> <!-- 保持 net8.0 -->
    <AssemblyVersion>v2.251104</AssemblyVersion>
    <FileVersion>v2.251104</FileVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>PinYinSort</AssemblyName>
    <RootNamespace>PinYinSort</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 核心 Emby 依赖 -->
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.80" />
    <!-- 使用 TinyPinyin -->
    <PackageReference Include="TinyPinyin" Version="1.1.0" />
    <!-- 添加 ILRepack -->
    <PackageReference Include="ILRepack" Version="2.0.44">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="ILRepack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="$(ILRepack) /out:&quot;$(OutputPath)$(TargetFileName)&quot; &quot;$(TargetPath)&quot; $(TargetDir)TinyPinyin.dll /lib:&quot;$(TargetDir)&quot;" />
  </Target>

</Project>
